{
  "name": "certificate-cover-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:pages & npm run dev:vite",
    "dev:vite": "vite --config vite.config.dev.js",
    "dev:pages": "wrangler pages dev dist --port=8788",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:pages": "wrangler pages deploy dist"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8",
    "wrangler": "^3.78.0"
  }
}
